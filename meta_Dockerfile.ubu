ARG UBUNTU_DIST=noble
FROM ubuntu:$UBUNTU_DIST

ARG BUN_VERSION
ARG UBUNTU_DIST
ARG BUILD_VERSION
ARG FULL_VERSION
ARG ARCH

RUN mkdir -p /output/DEBIAN

COPY packages/meta/output/DEBIAN/control /output/DEBIAN/
COPY packages/meta/output/DEBIAN/postinst /output/DEBIAN/postinst
RUN chmod 755 /output/DEBIAN/postinst

RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/control
RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/control
RUN sed -i "s/BUN_VERSION/$BUN_VERSION/" /output/DEBIAN/control
RUN sed -i "s/SUPPORTED_ARCHITECTURES/$ARCH/" /output/DEBIAN/control

RUN dpkg-deb --build /output /bun_$FULL_VERSION.deb
