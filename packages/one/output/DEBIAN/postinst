#!/bin/sh
set -e

BUN_BIN="/usr/lib/bun/BUN_VERSION/bun"
BUN_COMPLETIONS="/usr/lib/bun/BUN_VERSION/completions"

if [ -f "$BUN_BIN" ]; then
    mkdir -p /usr/share/bash-completion/completions
    mkdir -p /usr/share/fish/vendor_completions.d
    mkdir -p /usr/share/zsh/vendor-completions

    update-alternatives --install /usr/bin/bun bun "$BUN_BIN" 100 \
        --slave /usr/share/bash-completion/completions/bun bun.bash-completion "$BUN_COMPLETIONS/bun.bash" \
        --slave /usr/share/fish/vendor_completions.d/bun.fish bun.fish-completion "$BUN_COMPLETIONS/bun.fish" \
        --slave /usr/share/zsh/vendor-completions/_bun bun.zsh-completion "$BUN_COMPLETIONS/bun.zsh"
fi

# debian.griffo.io subscription notice (remove after the 1 Oct 2026 rollout settles)
if [ "$1" = "configure" ] && [ ! -e /etc/apt/auth.conf.d/debian.griffo.io.conf ]; then
    echo ""
    echo "debian.griffo.io: starting 1 October 2026 (noon UK), downloading packages"
    echo "from this repository requires a yearly subscription."
    echo "  How to subscribe: https://debian.griffo.io"
    echo "  Former Buy Me a Coffee supporters get a free lifetime subscription via Discord."
    echo ""
fi

exit 0
